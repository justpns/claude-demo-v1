# ── Google Sheets ───────────────────────────────────────────────────────────
# 1. Create a Google Cloud project and enable the Google Sheets API
# 2. Create a Service Account and download the JSON key
# 3. Share your Google Sheet with the service account email (Editor role)
# 4. Copy the Sheet ID from the URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit

GOOGLE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your_google_sheet_id_here

# ── Resend ───────────────────────────────────────────────────────────────────
# 1. Sign up at resend.com
# 2. Verify your sending domain
# 3. Create an API key

RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=Claude Code Workshop

# ── Workshop ─────────────────────────────────────────────────────────────────
# ISO 8601 date string for the workshop date (used for Day -1 reminder)
NEXT_PUBLIC_WORKSHOP_DATE=2025-09-15T09:00:00+07:00
NEXT_PUBLIC_WORKSHOP_DATE_DISPLAY=Saturday, 15 September 2025
NEXT_PUBLIC_WORKSHOP_TIME=9:00 AM – 5:00 PM (ICT)
NEXT_PUBLIC_WORKSHOP_LOCATION=Bangkok, Thailand (Venue TBD)

# ── Cron security ────────────────────────────────────────────────────────────
# Random secret to prevent unauthorized cron triggers (set same value in Vercel env)
CRON_SECRET=your_random_secret_here
